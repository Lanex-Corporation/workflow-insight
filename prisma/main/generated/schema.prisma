generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  github
  gitlab
  bitbucket
}

enum EventType {
  opened
  merged
  closed
  changes_requested
  pushed
  dismissed
  approved
  unapproved
  reopen
}

model Project {
  id           Int      @id @default(autoincrement())
  name         String
  repository   String
  events       Event[]
  tickets      Ticket[]
  contributors User[]   @relation("UserProjects")
}

model User {
  id                Int        @id @default(autoincrement())
  username          String     @unique
  first_name        String?
  last_name         String?
  projects          Project[]  @relation("UserProjects")
  events            Event[]
  reviewed_events   Event[]    @relation("ReviewedEvents")
  authoredRevisions Revision[] @relation("RevisionAuthor")
  reviewedRevisions Revision[] @relation("RevisionReviewer")
}

model Ticket {
  id         Int     @id @default(autoincrement())
  code       String  @unique
  events     Event[]
  project_id Int
  project    Project @relation(fields: [project_id], references: [id])
}

model Event {
  id            Int        @id @default(autoincrement())
  project       Project?   @relation(fields: [project_id], references: [id])
  project_id    Int?
  author        User?      @relation(fields: [author_id], references: [id])
  author_id     Int?
  reviewer      User?      @relation("ReviewedEvents", fields: [reviewer_id], references: [id])
  reviewer_id   Int?
  ticket        Ticket?    @relation(fields: [ticket_id], references: [id])
  ticket_id     Int?
  source        SourceType
  branch        String?
  pr_number     Int?
  additions     Int?
  deletions     Int?
  changed_files Int?
  event_type    EventType
  date_created  DateTime   @default(now())
  payload       Payload?   @relation("Payload")
  revision      Revision?

  @@index([project_id])
  @@index([author_id])
  @@index([ticket_id])
  @@index([author_id, ticket_id])
}

model Payload {
  id          Int   @id @default(autoincrement())
  raw_payload Json
  event       Event @relation("Payload", fields: [event_id], references: [id])
  event_id    Int   @unique
}

model Revision {
  id          Int   @id @default(autoincrement())
  user_id     Int
  user        User  @relation("RevisionAuthor", fields: [user_id], references: [id])
  reviewer_id Int?
  reviewer    User? @relation("RevisionReviewer", fields: [reviewer_id], references: [id])
  pr_event_id Int
  pr_event    Event @relation(fields: [pr_event_id], references: [id])

  @@unique([pr_event_id])
  @@index([pr_event_id])
  @@index([reviewer_id])
  @@index([user_id])
}

model JiraEvent {
  id               Int          @id @default(autoincrement())
  webhook_event    String
  issue_event_type String
  issue            JiraIssue?   @relation(fields: [issue_id], references: [id])
  issue_id         Int?
  // changelog_id      String?
  project_id       Int?
  project          JiraProject? @relation(fields: [project_id], references: [id])
  user_id          Int?
  user             JiraUser?    @relation(fields: [user_id], references: [id])
  payload          JiraPayload? @relation("JiraPayload")
  date_created     DateTime     @default(now())
}

model JiraProject {
  id         Int         @id @default(autoincrement())
  key        String      @unique
  name       String
  issues     JiraIssue[]
  created_at DateTime    @default(now())
  JiraEvent  JiraEvent[]
}

model JiraUser {
  id              Int         @id @default(autoincrement())
  account_id      String      @unique
  display_name    String?
  created_issues  JiraIssue[] @relation("CreatedIssues")
  assigned_issues JiraIssue[] @relation("AssignedIssues")
  JiraEvent       JiraEvent[]
}

model JiraIssue {
  id              Int          @id @default(autoincrement())
  issue_id        String       @unique @map("issueId")
  summary         String?
  key             String
  status_name     String?
  status_id       String?
  timespent       Int?
  timeestimate    Int?
  created_at      DateTime?
  updated_at      DateTime?
  resolution_date DateTime?
  project_id      Int?
  project         JiraProject? @relation(fields: [project_id], references: [id])
  creator_id      Int?
  creator         JiraUser?    @relation("CreatedIssues", fields: [creator_id], references: [id])
  assignee_id     Int?
  assignee        JiraUser?    @relation("AssignedIssues", fields: [assignee_id], references: [id])
  sprint_name     String?
  sprint_start    DateTime?
  sprint_end      DateTime?
  raw_fields      Json?
  events          JiraEvent[]
}

model JiraPayload {
  id          Int       @id @default(autoincrement())
  raw_payload Json
  event       JiraEvent @relation("JiraPayload", fields: [event_id], references: [id])
  event_id    Int       @unique
}
