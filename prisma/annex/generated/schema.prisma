generator annexClient {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource annex {
  provider = "mysql"
  url      = env("ANNEX_DATABASE_URL")
}

enum SourceTypeAnnex {
  github
  gitlab
  bitbucket
}

enum EventTypeAnnex {
  opened
  merged
  closed
  changes_requested
  pushed
  dismissed
  approved
  unapproved
  reopen
}

model ProjectAnnex {
  id           Int           @id @default(autoincrement())
  name         String
  repository   String
  events       EventAnnex[]
  tickets      TicketAnnex[]
  contributors UserAnnex[]   @relation("UserProjects")

  @@map("Project")
}

model UserAnnex {
  id                Int             @id @default(autoincrement())
  username          String          @unique
  first_name        String?
  last_name         String?
  projects          ProjectAnnex[]  @relation("UserProjects")
  events            EventAnnex[]
  reviewed_events   EventAnnex[]    @relation("ReviewedEvents")
  authoredRevisions RevisionAnnex[] @relation("RevisionAuthor")
  reviewedRevisions RevisionAnnex[] @relation("RevisionReviewer")

  @@map("User")
}

model TicketAnnex {
  id         Int          @id @default(autoincrement())
  code       String       @unique
  events     EventAnnex[]
  project_id Int
  project    ProjectAnnex @relation(fields: [project_id], references: [id], map: "Annex_Ticket_project_id_fkey")

  @@map("Ticket")
}

model EventAnnex {
  id              Int             @id @default(autoincrement())
  github_event_id String?         @unique
  project         ProjectAnnex?   @relation(fields: [project_id], references: [id], map: "Annex_Event_project_id_fkey")
  project_id      Int?
  author          UserAnnex?      @relation(fields: [author_id], references: [id], map: "Annex_Event_author_id_fkey")
  author_id       Int?
  reviewer        UserAnnex?      @relation("ReviewedEvents", fields: [reviewer_id], references: [id], map: "Annex_Event_reviewer_id_fkey")
  reviewer_id     Int?
  ticket          TicketAnnex?    @relation(fields: [ticket_id], references: [id], map: "Annex_Event_ticket_id_fkey")
  ticket_id       Int?
  source          SourceTypeAnnex
  branch          String?
  pr_number       Int?
  additions       Int?
  deletions       Int?
  changed_files   Int?
  event_type      EventTypeAnnex
  date_created    DateTime        @default(now())

  // Relations to payload and revision (cleaned)
  payload  PayloadAnnex?  @relation("EventToPayload")
  revision RevisionAnnex? @relation("EventToRevision")

  @@index([project_id])
  @@index([author_id])
  @@index([ticket_id])
  @@index([author_id, ticket_id])
  @@map("Event")
}

model PayloadAnnex {
  id          Int        @id @default(autoincrement())
  raw_payload Json
  event_id    Int        @unique
  event       EventAnnex @relation("EventToPayload", fields: [event_id], references: [id], map: "Annex_Payload_event_id_fkey")

  @@map("Payload")
}

model RevisionAnnex {
  id          Int        @id @default(autoincrement())
  user_id     Int
  user        UserAnnex  @relation("RevisionAuthor", fields: [user_id], references: [id], map: "Annex_Revision_user_id_fkey")
  reviewer_id Int?
  reviewer    UserAnnex? @relation("RevisionReviewer", fields: [reviewer_id], references: [id], map: "Annex_Revision_reviewer_id_fkey")

  pr_event_id Int
  pr_event    EventAnnex @relation("EventToRevision", fields: [pr_event_id], references: [id], map: "Annex_Revision_pr_event_id_fkey")

  @@unique([pr_event_id])
  @@index([pr_event_id])
  @@index([reviewer_id])
  @@index([user_id])
  @@map("Revision")
}
